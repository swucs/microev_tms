### 로그인 : Admin
POST {{admin}}/login
Content-Type: application/json

{
  "email": "admin@obigo.com",
  "password": "1234"
}
> {%
    client.global.set("access-token", response.body.data.accessToken);
    client.global.set("refresh-token", response.body.data.refreshToken);
%}


### 권역 목록조회
GET {{admin}}/region?regionName=&vehicleName=&eupMyeonDong=
Authorization: Bearer {{access-token}}


### 권역 등록
POST {{admin}}/region
Content-Type: application/json
Authorization: Bearer {{access-token}}

{
  "regionName": "판교1권역",
  "eupMyeonDongs" : ["경기도 성남시 분당구 백현동", "경기도 성남시 분당구 삼평동", "경기도 성남시 분당구 이매동", "경기도 성남시 분당구 야탑동"]
}


### 권역 상세조회
GET {{admin}}/region/4
Content-Type: application/json
Authorization: Bearer {{access-token}}


### 권역 수정
PUT {{admin}}/region/1
Content-Type: application/json
Authorization: Bearer {{access-token}}

{
  "regionName": "판교1권역",
  "eupMyeonDongs" : ["경기도 성남시 분당구 백현동", "경기도 성남시 분당구 삼평동", "경기도 성남시 분당구 이매동"]
}


### 권역 삭제
DELETE {{admin}}/region/2
Content-Type: application/json
Authorization: Bearer {{access-token}}