  "workingDays": "화수목금",
  "workingStartHour": "10:00",
  "workingEndHour": "17:00",
  "statusCd": "WORKING"
}

### 배송기사 비밀번호 수정
PUT {{admin}}/driver/3/password
Content-Type: application/json
Authorization: Bearer {{access-token}}

{
  "password": "1234"
}

### 배송기사 삭제
DELETE {{admin}}/driver/3
Content-Type: application/json
Authorization: Bearer {{access-token}}