### 로그인 : Admin
POST {{admin}}/login
Content-Type: application/json

{
  "email": "admin@obigo.com",
  "password": "1234"
}
> {%
    client.global.set("access-token", response.body.data.accessToken);
    client.global.set("refresh-token", response.body.data.refreshToken);
%}


### 센터 목록조회
GET {{admin}}/center?centerName=&centerTypeCd=&managerName=
Authorization: Bearer {{access-token}}


### 센터 등록
POST {{admin}}/center
Content-Type: application/json
Authorization: Bearer {{access-token}}

{
  "centerName": "롯데택배 테스트",
  "centerTypeCd": "DELIVERY",
  "zipCode": "13465",
  "centerAddr1": "서울 성동구 마장로 44길 6",
  "centerAddr2": "4호실, 5호실",
  "latitude": "37.4060975",
  "longitude": "127.2145405",
  "totalArea": "177.5",
  "managerName": "김롯데",
  "contactNum": "02-454-3355",
  "usageYn": "Y"
}


### 센터 상세조회
GET {{admin}}/center/3
Content-Type: application/json
Authorization: Bearer {{access-token}}


### 센터 수정
PUT {{admin}}/center/3
Content-Type: application/json
Authorization: Bearer {{access-token}}

{
  "centerName": "롯데택배 서울종로지점",
  "centerTypeCd": "DELIVERY",
  "zipCode": "13465",
  "centerAddr1": "서울 성동구 마장로 44길 6",
  "centerAddr2": "4호실, 5호실",
  "latitude": "37.4060975",
  "longitude": "127.2145405",
  "totalArea": "177.5",
  "managerName": "김롯데",
  "contactNum": "02-454-3355",
  "usageYn": "Y"
}


### 센터 삭제
DELETE {{admin}}/center/3
Content-Type: application/json
Authorization: Bearer {{access-token}}


### 해당 센터의 차량 목록 조회
GET {{admin}}/center/1/vehicle
Authorization: Bearer {{access-token}}